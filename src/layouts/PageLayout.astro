---
import Layout from './Layout.astro';
import Background from '../components/Background.astro';
import InfoTopBar from '../components/InfoTopBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	canonical: string;
}

const { title, description, canonical } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical}>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink"
		>Skip to content</a
	>
	<Background />
	<InfoTopBar />

	<main id="main" class="relative mx-auto w-full max-w-3xl px-4 pb-16 pt-[calc(5.5rem+env(safe-area-inset-top))] sm:px-6 sm:pt-[calc(6.5rem+env(safe-area-inset-top))]">
		<div class="glass animate-fade-in px-6 py-8 sm:px-10 sm:py-10">
			<slot />
		</div>
	</main>

	<Footer />

	<script>
		import '../lib/info.ts';
	</script>
</Layout>

<style>
	#main {
		min-height: calc(100vh - 16rem);
	}
</style>
