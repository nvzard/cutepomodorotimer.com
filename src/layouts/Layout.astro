---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cute Pomodoro Timer',
	description = 'A calm, aesthetic Pomodoro timer with lo-fi music, a live ambient scene and gentle focus — right in your browser.',
} = Astro.props;

const canonical = 'https://cutepomodorotimer.com';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f7f2ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#17171b" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cute Pomodoro Timer" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>

		<Font cssVariable="--font-quicksand" preload />

		<script is:inline>
			(function () {
				var stored = null;
				try {
					stored = localStorage.getItem('pomo:theme');
				} catch (e) {}
				var theme =
					stored ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.classList.toggle('dark', theme === 'dark');
			})();
		</script>
	</head>
	<body data-phase="focus">
		<slot />
	</body>
</html>
