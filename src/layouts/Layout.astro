---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cute Timer — Cute Pomodoro Timer Online for Studying',
	description = 'A free cute timer online — an aesthetic pink pomodoro timer for studying with lo-fi music, a cute mascot, and 10, 15 & 30 minute countdowns. Start now.',
} = Astro.props;

const canonical = 'https://cutepomodorotimer.com';

const keywords = [
	'cute timer',
	'cute timer online',
	'cute timer for studying',
	'pomodoro timer',
	'cute timer website',
	'timer cute',
	'cute timer countdown',
	'cute timer app',
	'30 minute cute timer',
	'cute timer apps',
	'10 minute cute timer',
	'cute timer 30 minutes',
	'cute timer clock',
	'pomodoro cute timer',
	'cute pomodoro timer',
	'cute timer 15 minutes',
	'cute timer clock for study',
	'pink cute timer',
	'cute timer aesthetic',
	'a cute timer',
	'pomodoro timer app',
	'online pomodoro timer',
	'free pomodoro timer',
	'aesthetic pomodoro timer',
].join(', ');

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Cute Timer',
	url: canonical,
	description,
	applicationCategory: 'UtilityApplication',
	operatingSystem: 'Any',
	browserRequirements: 'Requires JavaScript',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	keywords,
	inLanguage: 'en',
	audience: { '@type': 'Audience', audienceType: 'Students, remote workers, and anyone who loves a cute timer for studying' },
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#fff3f8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#231926" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="CuteTimer" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cute Timer" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content="/web-app-manifest-512x512.png" />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="/web-app-manifest-512x512.png" />
		<title>{title}</title>

		<script
			type="application/ld+json"
			set:html={JSON.stringify(schema)}
		></script>

		<slot name="head" />

		<Font cssVariable="--font-baloo" preload />

		<script is:inline>
			(function () {
				var stored = null;
				try {
					stored = localStorage.getItem('pomo:theme');
				} catch (e) {}
				var theme =
					stored ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.classList.toggle('dark', theme === 'dark');

				var lang = null;
				try {
					lang = localStorage.getItem('pomo:lang');
				} catch (e) {}
				if (!lang) lang = (navigator.language || 'en').slice(0, 2).toLowerCase();
				var known = ['en', 'es', 'de', 'fr', 'hi', 'ja', 'pt'];
				if (known.indexOf(lang) !== -1) document.documentElement.lang = lang;
			})();
		</script>
	</head>
	<body data-phase="focus">
		<slot />
	</body>
</html>
