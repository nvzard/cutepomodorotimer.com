---
import Layout from '../layouts/Layout.astro';
import Background from '../components/Background.astro';
import TopBar from '../components/TopBar.astro';
import Timer from '../components/Timer.astro';
import TodoPanel from '../components/TodoPanel.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import Dock from '../components/Dock.astro';
---

<Layout>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink"
		>Skip to timer</a
	>
	<Background />
	<TopBar />

	<main
		id="main"
		class="relative flex min-h-screen flex-col items-center justify-center px-4"
	>
		<h1 class="sr-only">Cute Pomodoro Timer</h1>
		<Timer />
		<p class="mt-10 hidden text-xs text-mute/80 md:block">
			<span class="font-semibold">space</span> start &middot; <span class="font-semibold">r</span> reset &middot;
			<span class="font-semibold">m</span> music &middot; <span class="font-semibold">d</span> <span data-theme-shortcut-label>dark mode</span>
			<span class="text-[var(--accent)]">♡</span>
		</p>
	</main>

	<TodoPanel />
	<SettingsPanel />
	<Dock />

	<script>
		import '../lib/app.ts';
	</script>
</Layout>

<style>
	/* Responsive padding so the timer always fits between the fixed top bar
	   and bottom dock — compact on phones, roomier on taller/desktop screens. */
	#main {
		padding-top: calc(4.5rem + env(safe-area-inset-top));
		padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));
	}
	@media (min-width: 768px) {
		#main {
			padding-top: calc(6rem + env(safe-area-inset-top));
			padding-bottom: calc(9rem + env(safe-area-inset-bottom));
		}
	}
	@media (max-height: 720px) {
		#main {
			padding-top: calc(4rem + env(safe-area-inset-top));
			padding-bottom: calc(6rem + env(safe-area-inset-bottom));
		}
	}
</style>
