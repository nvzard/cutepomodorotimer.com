---
import PageLayout from '../layouts/PageLayout.astro';
import Mascot from '../components/Mascot.astro';

interface Props {
	error: unknown;
}

const { error } = Astro.props;
const message =
	error instanceof Error && error.message ? error.message : 'Something went wrong on our side.';
---

<PageLayout
	title="500 — Something Went Wrong | Cute Timer"
	description="Something went wrong on our side. Head back to the Cute Pomodoro Timer home to start a focus session."
	canonical="https://cutepomodorotimer.com/500/"
>
	<div class="flex flex-col items-center text-center">
		<div class="grid h-24 w-24 place-items-center">
			<Mascot class="h-full w-full" />
		</div>
		<p class="eyebrow mt-6 text-[var(--accent-ink)]">Whoopsie ♡</p>
		<h1 class="mt-2 text-4xl font-extrabold leading-snug text-ink sm:text-5xl">500</h1>
		<p class="mt-4 text-sm leading-relaxed text-body sm:text-base">
			Our tomato got a little flustered. Please try again in a moment.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--tomato)] px-6 py-3 text-sm font-bold text-white shadow-[0_4px_0_color-mix(in_srgb,var(--tomato)_60%,#000)] transition-transform hover:-translate-y-0.5"
		>
			Back to the timer ♡
		</a>
	</div>
</PageLayout>
