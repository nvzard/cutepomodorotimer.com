---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
	title="Contact Us — Cute Timer | Cute Pomodoro Timer"
	description="Get in touch with the Cute Timer team. Questions, feedback, or just to say hi to Pommy the tomato — we'd love to hear from you."
	canonical="https://cutepomodorotimer.com/contact/"
>
	<p class="eyebrow text-[var(--accent-ink)]">Say hello ♡</p>
	<h1 class="mt-2 text-3xl font-extrabold leading-snug text-ink sm:text-4xl">
		Contact Us
	</h1>
	<p class="mt-4 text-sm leading-relaxed text-body sm:text-base">
		Questions, feature ideas, or just want to tell Pommy the tomato that
		she's doing a great job? We'd genuinely love to hear from you. Fill out
		the form and it will open your email app with everything ready to send —
		no account, no tracking, no fuss.
	</p>

	<form id="contact-form" class="mt-8 space-y-5">
		<div>
			<label
				for="contact-name"
				class="mb-1.5 block text-sm font-bold text-ink">Your name</label
			>
			<input
				id="contact-name"
				name="name"
				type="text"
				required
				placeholder="Pommy the Tomato"
				class="w-full rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			/>
		</div>

		<div>
			<label
				for="contact-email"
				class="mb-1.5 block text-sm font-bold text-ink"
				>Your email</label
			>
			<input
				id="contact-email"
				name="email"
				type="email"
				required
				placeholder="you@example.com"
				class="w-full rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			/>
		</div>

		<div>
			<label
				for="contact-message"
				class="mb-1.5 block text-sm font-bold text-ink"
				>Your message</label
			>
			<textarea
				id="contact-message"
				name="message"
				required
				rows="5"
				placeholder="Tell us what's on your mind…"
				class="w-full resize-y rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			></textarea>
		</div>

		<button
			type="submit"
			class="sticker-btn px-6 py-3 text-sm font-bold"
			style="--btn-bg: var(--tomato-deep); --btn-ink: #fff; --btn-edge: color-mix(in srgb, var(--tomato-deep) 70%, #000)"
		>
			Send message ♡
		</button>
	</form>

	<section
		class="mt-10 rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_10%,transparent)] bg-[color-mix(in_srgb,var(--surface)_80%,transparent)] p-5 sm:p-6"
	>
		<h2 class="mb-2 text-lg font-extrabold text-ink">
			Prefer to email directly?
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base">
			You can always write to us at&nbsp;
			<a
				href="mailto:hello@cutepomodorotimer.com"
				class="font-semibold text-[var(--accent-ink)] underline decoration-[color-mix(in_srgb,var(--accent)_50%,transparent)] underline-offset-2 transition-colors hover:text-ink"
				>hello@cutepomodorotimer.com</a
			>. We read every message and reply as soon as Pommy lets us take a
			break.
		</p>
	</section>

	<script>
		const form = document.getElementById(
			"contact-form",
		) as HTMLFormElement | null;
		form?.addEventListener("submit", (e) => {
			e.preventDefault();
			const data = new FormData(form);
			const name = String(data.get("name") ?? "").trim();
			const email = String(data.get("email") ?? "").trim();
			const message = String(data.get("message") ?? "").trim();
			const subject = encodeURIComponent(
				`Message from ${name || "a friendly visitor"}`,
			);
			const body = encodeURIComponent(
				`Name: ${name}\nEmail: ${email}\n\n${message}`,
			);
			window.location.href = `mailto:hello@cutepomodorotimer.com?subject=${subject}&body=${body}`;
		});
	</script>
</PageLayout>
