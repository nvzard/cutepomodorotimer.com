---
import Icon from './Icon.astro';
---

<div
	class="glass fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] left-1/2 z-30 flex w-[calc(100%-2rem)] max-w-lg -translate-x-1/2 items-center justify-between gap-1.5 rounded-full px-2.5 py-2 sm:gap-2 sm:px-3.5"
	data-music
	role="region"
	data-i18n-aria="dock.regionAria"
	aria-label="Task and lo-fi music"
>
	<audio data-audio="0" src="/lofi/coffee-shop.mp3" loop preload="none"></audio>
	<audio data-audio="1" src="/lofi/chill-vlog-beats.mp3" loop preload="none"></audio>

	<!-- Task list toggle -->
	<button
		type="button"
		data-todo-btn
		class="icon-btn relative h-10 w-10 shrink-0 sm:h-11 sm:w-11"
		data-i18n-aria="dock.todoAria"
		aria-label="Open task list"
		aria-expanded="false"
	>
		<Icon name="list" size={20} />
		<span
			data-todo-count
			class="absolute right-0.5 top-0.5 hidden h-4 min-w-4 items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--tomato-deep)_60%,#4b1430)] px-1 text-[10px] font-bold leading-none text-white"
			>0</span
		>
	</button>

	<div class="h-6 w-px shrink-0 bg-[color-mix(in_srgb,var(--ink)_12%,transparent)]"></div>

	<!-- Music player -->
	<button
		type="button"
		data-music-play
		class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white transition-transform sm:h-11 sm:w-11"
		aria-label="Play lo-fi music"
		aria-pressed="false"
	>
		<span data-music-play-icon class="flex translate-x-[1px]"><Icon name="play" size={18} /></span>
	</button>

	<button
		type="button"
		data-track-btn
		class="flex min-w-0 items-center gap-2 rounded-full px-1 py-1 text-sm font-semibold text-body transition-colors hover:text-ink"
	>
		<span data-eq class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
		<span data-track-label class="truncate">coffee shop</span>
		<span class="sr-only" data-i18n="dock.switchTrack">switch lo-fi track</span>
		<Icon name="repeat" size={14} class="shrink-0" />
	</button>

	<div class="flex shrink-0 items-center gap-1.5">
		<input
			type="range"
			data-volume
			min="0"
			max="100"
			value="60"
			class="slider hidden w-14 sm:block sm:w-24"
			data-i18n-aria="dock.volumeAria"
			aria-label="Music volume"
		/>
		<button type="button" data-mute-btn class="icon-btn h-9 w-9" data-i18n-aria="dock.muteAria" aria-label="Mute music" aria-pressed="false">
			<span data-volume-icon><Icon name="volume-2" size={18} /></span>
		</button>
	</div>

	<button
		type="button"
		data-spotify-btn
		class="icon-btn h-10 w-10 shrink-0 sm:h-11 sm:w-11"
		data-i18n-aria="dock.spotifyAria"
		aria-label="Open Spotify playlist"
		aria-expanded="false"
	>
		<Icon name="spotify" size={20} />
	</button>

	<div class="flex shrink-0 items-center gap-1.5">
		<button
			type="button"
			data-upload-btn
			class="icon-btn h-9 w-9"
			data-i18n-aria="dock.uploadAria"
			aria-label="Upload your own music"
		>
			<Icon name="upload" size={16} />
		</button>
		<button
			type="button"
			data-custom-remove
			class="icon-btn h-9 w-9 hidden"
			data-i18n-aria="dock.removeCustomAria"
			aria-label="Remove uploaded track"
		>
			<Icon name="x" size={14} />
		</button>
	</div>

	<input type="file" data-file-input accept="audio/*,.mp3,.wav,.m4a,.ogg,.flac" class="hidden" />
</div>

<style>
	[data-music-play] {
		background: var(--tomato-deep);
		border: 2.5px solid color-mix(in srgb, var(--tomato-deep) 68%, #000);
		box-shadow:
			0 4px 0 color-mix(in srgb, var(--tomato-deep) 68%, #000),
			0 12px 20px -10px color-mix(in srgb, var(--tomato) 70%, transparent);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			background-color 0.2s ease;
	}
	[data-music-play]:hover {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--tomato-deep) 92%, var(--ink));
	}
	[data-music-play]:active {
		transform: translateY(3px);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--tomato-deep) 68%, #000);
	}

	.eq {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 14px;
		width: 14px;
		opacity: 0.35;
		transition: opacity 0.3s ease;
	}
	.eq i {
		width: 3px;
		border-radius: 9999px;
		background: var(--tomato);
		height: 40%;
	}
	.eq i:nth-child(2) {
		height: 75%;
	}
	.eq i:nth-child(3) {
		height: 55%;
	}
	[data-playing='true'] .eq {
		opacity: 1;
	}
	[data-playing='true'] .eq i {
		animation: eq-bounce 1.1s ease-in-out infinite;
	}

	[data-volume]:disabled,
	[data-mute-btn]:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	[data-playing='true'] .eq i:nth-child(2) {
		animation-delay: 0.22s;
	}
	[data-playing='true'] .eq i:nth-child(3) {
		animation-delay: 0.44s;
	}

	@keyframes eq-bounce {
		0%,
		100% {
			height: 35%;
		}
		50% {
			height: 100%;
		}
	}
</style>
