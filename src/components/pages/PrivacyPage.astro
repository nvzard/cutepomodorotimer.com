---
import PageLayout from '../../layouts/PageLayout.astro';
import { t, DEFAULT_LANG, type LangCode, type TranslationKey } from '../../lib/i18n';

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as LangCode;
---

<PageLayout page="privacy">
	<p class="eyebrow text-[var(--accent-ink)]" data-i18n="privacy.eyebrow">
		{t(lang, 'privacy.eyebrow' as TranslationKey)}
	</p>
	<h1 class="mt-2 text-3xl font-extrabold leading-snug text-ink sm:text-4xl" data-i18n="privacy.title">
		{t(lang, 'privacy.title' as TranslationKey)}
	</h1>
	<p class="mt-4 text-sm leading-relaxed text-body sm:text-base">
		<span data-i18n="page.lastUpdated">{t(lang, 'page.lastUpdated' as TranslationKey)}</span>{' '}
		<span class="font-semibold text-ink" data-i18n="page.lastUpdatedDate">{t(lang, 'page.lastUpdatedDate' as TranslationKey)}</span>
		. <span data-i18n="privacy.introAfterDate">{t(lang, 'privacy.introAfterDate' as TranslationKey)}</span>{' '}
		<span class="font-semibold text-ink">cutepomodorotimer.com</span>.
	</p>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec1Title">
			{t(lang, 'privacy.sec1Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec1Body">
			{t(lang, 'privacy.sec1Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec2Title">
			{t(lang, 'privacy.sec2Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec2Body">
			{t(lang, 'privacy.sec2Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec3Title">
			{t(lang, 'privacy.sec3Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec3Body">
			{t(lang, 'privacy.sec3Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec4Title">
			{t(lang, 'privacy.sec4Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec4Body">
			{t(lang, 'privacy.sec4Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec5Title">
			{t(lang, 'privacy.sec5Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec5Body">
			{t(lang, 'privacy.sec5Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec6Title">
			{t(lang, 'privacy.sec6Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec6Body">
			{t(lang, 'privacy.sec6Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec7Title">
			{t(lang, 'privacy.sec7Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base" data-i18n="privacy.sec7Body">
			{t(lang, 'privacy.sec7Body' as TranslationKey)}
		</p>
	</section>

	<section class="mt-8">
		<h2 class="mb-3 text-2xl font-extrabold leading-snug text-ink sm:text-3xl" data-i18n="privacy.sec8Title">
			{t(lang, 'privacy.sec8Title' as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base">
			<span data-i18n="privacy.sec8Prefix">{t(lang, 'privacy.sec8Prefix' as TranslationKey)}</span>{' '}
			<a
				href="mailto:hello@cutepomodorotimer.com"
				class="font-semibold text-[var(--accent-ink)] underline decoration-[color-mix(in_srgb,var(--accent)_50%,transparent)] underline-offset-2 transition-colors hover:text-ink"
				>hello@cutepomodorotimer.com</a
			>.
		</p>
	</section>
</PageLayout>
