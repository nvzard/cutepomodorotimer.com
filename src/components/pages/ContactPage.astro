---
import PageLayout from "../../layouts/PageLayout.astro";
import { t, DEFAULT_LANG, type LangCode, type TranslationKey } from "../../lib/i18n";

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as LangCode;
---

<PageLayout page="contact">
	<p class="eyebrow text-[var(--accent-ink)]" data-i18n="contact.eyebrow">
		{t(lang, "contact.eyebrow" as TranslationKey)}
	</p>
	<h1 class="mt-2 text-3xl font-extrabold leading-snug text-ink sm:text-4xl" data-i18n="contact.title">
		{t(lang, "contact.title" as TranslationKey)}
	</h1>
	<p class="mt-4 text-sm leading-relaxed text-body sm:text-base" data-i18n="contact.intro">
		{t(lang, "contact.intro" as TranslationKey)}
	</p>

	<form id="contact-form" class="mt-8 space-y-5">
		<div>
			<label
				for="contact-name"
				class="mb-1.5 block text-sm font-bold text-ink"
				data-i18n="contact.nameLabel"
				>{t(lang, "contact.nameLabel" as TranslationKey)}</label
			>
			<input
				id="contact-name"
				name="name"
				type="text"
				required
				data-i18n-placeholder="contact.namePlaceholder"
				placeholder={t(lang, "contact.namePlaceholder" as TranslationKey)}
				class="w-full rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			/>
		</div>

		<div>
			<label
				for="contact-email"
				class="mb-1.5 block text-sm font-bold text-ink"
				data-i18n="contact.emailLabel"
				>{t(lang, "contact.emailLabel" as TranslationKey)}</label
			>
			<input
				id="contact-email"
				name="email"
				type="email"
				required
				data-i18n-placeholder="contact.emailPlaceholder"
				placeholder={t(lang, "contact.emailPlaceholder" as TranslationKey)}
				class="w-full rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			/>
		</div>

		<div>
			<label
				for="contact-message"
				class="mb-1.5 block text-sm font-bold text-ink"
				data-i18n="contact.messageLabel"
				>{t(lang, "contact.messageLabel" as TranslationKey)}</label
			>
			<textarea
				id="contact-message"
				name="message"
				required
				rows="5"
				data-i18n-placeholder="contact.messagePlaceholder"
				placeholder={t(lang, "contact.messagePlaceholder" as TranslationKey)}
				class="w-full resize-y rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-mute/70 focus:border-[var(--accent)]"
			></textarea>
		</div>

		<button
			type="submit"
			class="sticker-btn px-6 py-3 text-sm font-bold"
			style="--btn-bg: var(--tomato-deep); --btn-ink: #fff; --btn-edge: color-mix(in srgb, var(--tomato-deep) 70%, #000)"
			data-i18n="contact.submit"
		>
			{t(lang, "contact.submit" as TranslationKey)}
		</button>
	</form>

	<section
		class="mt-10 rounded-2xl border-2 border-[color-mix(in_srgb,var(--ink)_10%,transparent)] bg-[color-mix(in_srgb,var(--surface)_80%,transparent)] p-5 sm:p-6"
	>
		<h2 class="mb-2 text-lg font-extrabold text-ink" data-i18n="contact.directTitle">
			{t(lang, "contact.directTitle" as TranslationKey)}
		</h2>
		<p class="text-sm leading-relaxed text-body sm:text-base">
			{t(lang, "contact.directPrefix" as TranslationKey)}&nbsp;
			<a
				href="mailto:hello@cutepomodorotimer.com"
				class="font-semibold text-[var(--accent-ink)] underline decoration-[color-mix(in_srgb,var(--accent)_50%,transparent)] underline-offset-2 transition-colors hover:text-ink"
				>hello@cutepomodorotimer.com</a
			>. {t(lang, "contact.directSuffix" as TranslationKey)}
		</p>
	</section>

	<script>
		import { getLang, t, type TranslationKey } from "../../lib/i18n";

		const form = document.getElementById(
			"contact-form",
		) as HTMLFormElement | null;
		form?.addEventListener("submit", (e) => {
			e.preventDefault();
			const lang = getLang();
			const data = new FormData(form);
			const name = String(data.get("name") ?? "").trim();
			const email = String(data.get("email") ?? "").trim();
			const message = String(data.get("message") ?? "").trim();
			const subject = encodeURIComponent(
				`${t(lang, "contact.subjectFrom" as TranslationKey)} ${
					name || t(lang, "contact.subjectFallback" as TranslationKey)
				}`,
			);
			const body = encodeURIComponent(
				`${t(lang, "contact.bodyName" as TranslationKey)}: ${name}\n${t(lang, "contact.bodyEmail" as TranslationKey)}: ${email}\n\n${message}`,
			);
			window.location.href = `mailto:hello@cutepomodorotimer.com?subject=${subject}&body=${body}`;
		});
	</script>
</PageLayout>
