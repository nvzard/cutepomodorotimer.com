---
import Icon from './Icon.astro';
---

<header class="fixed inset-x-0 top-0 z-30 flex items-center justify-between px-4 pb-3 pt-[calc(0.75rem+env(safe-area-inset-top))] sm:px-6">
	<a href="/" class="group flex items-center gap-2.5" aria-label="Cute Pomodoro Timer home">
		<span
			class="grid h-9 w-9 place-items-center rounded-full border-2 border-[color-mix(in_srgb,var(--tomato)_55%,transparent)] bg-[var(--tomato-soft)] text-[var(--tomato)] shadow-[0_3px_0_color-mix(in_srgb,var(--tomato)_35%,transparent)] transition-transform group-hover:-rotate-6 group-hover:scale-110"
		>
			<Icon name="tomato-small" size={22} />
		</span>
		<span class="text-base font-bold tracking-tight">
			Cute Pomodoro <span class="text-[var(--tomato)]">♡</span>
		</span>
	</a>

	<div class="flex items-center gap-1.5">
		<button type="button" data-theme-toggle class="icon-btn" aria-label="Toggle dark mode">
			<span data-theme-icon-sun><Icon name="sun" size={19} /></span>
			<span data-theme-icon-moon><Icon name="moon" size={19} /></span>
		</button>
		<button type="button" data-settings-btn class="icon-btn" aria-label="Open settings" aria-expanded="false">
			<Icon name="gear" size={19} />
		</button>
	</div>
</header>

<style>
	html:not(.dark) [data-theme-icon-sun] {
		display: none;
	}
	html.dark [data-theme-icon-moon] {
		display: none;
	}
</style>
