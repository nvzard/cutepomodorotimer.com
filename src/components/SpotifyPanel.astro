---
import Icon from './Icon.astro';
---

<div
	data-spotify-panel
	class="glass fixed bottom-24 left-1/2 z-40 hidden w-[min(26rem,calc(100vw-2rem))] -translate-x-1/2 overflow-hidden rounded-3xl p-5 animate-pop"
	role="dialog"
	data-i18n-aria="spotify.panelAria"
	aria-label="Spotify focus playlist"
>
	<div class="mb-4 flex items-center justify-between">
		<h2 class="flex items-center gap-1.5 text-base font-bold">
			<span class="text-[var(--tomato)]"><Icon name="music" size={16} /></span>
			<span data-i18n="spotify.title">Focus playlist</span>
		</h2>
		<button type="button" data-spotify-close class="icon-btn h-8 w-8" data-i18n-aria="spotify.closeAria" aria-label="Close music player">
			<Icon name="x" size={16} />
		</button>
	</div>

	<div>
		<iframe
			data-testid="embed-iframe"
			data-spotify-frame
			title="Spotify focus playlist"
			src="https://open.spotify.com/embed/playlist/37i9dQZF1DWZZbwlv3Vmtr?utm_source=generator&theme=0&si=2b71826d4bb04043"
			style="border-radius: 12px"
			width="100%"
			height="152"
			frameborder="0"
			allowfullscreen=""
			allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
			loading="lazy"
		></iframe>
	</div>

	<form data-spotify-form class="mt-3 flex gap-2">
		<input
			type="url"
			name="spotify-url"
			data-spotify-url
			data-i18n-placeholder="spotify.urlPlaceholder"
			placeholder="Paste a Spotify link…"
			data-i18n-aria="spotify.urlAria"
			aria-label="Spotify link"
			autocomplete="off"
			spellcheck="false"
			class="h-10 min-w-0 flex-1 rounded-full border border-line bg-surface px-4 text-sm text-ink placeholder:text-mute focus:border-[var(--tomato)] focus:outline-none"
		/>
		<button
			type="submit"
			class="pill-btn h-10 shrink-0 border-2 border-[color-mix(in_srgb,var(--tomato)_45%,transparent)] bg-[var(--tomato-soft)] px-4 text-sm font-bold text-[var(--ink)] shadow-[0_3px_0_color-mix(in_srgb,var(--tomato)_28%,transparent)]"
		>
			<span data-i18n="spotify.apply">Play</span>
		</button>
	</form>

	<p data-spotify-error class="mt-2 hidden text-xs font-semibold text-[var(--tomato-deep)]" data-i18n="spotify.urlError">
		That doesn't look like a Spotify link — try a track, album, or playlist URL.
	</p>
	<div data-spotify-own-note class="mt-1 text-xs leading-relaxed text-mute">
		<span data-i18n="spotify.ownHint">Paste any Spotify link (track, album, or playlist) to play it instead of the preset playlist.</span>
		<button
			type="button"
			data-spotify-reset
			class="hidden ml-1 font-bold text-[var(--tomato-deep)] underline underline-offset-2 hover:text-ink"
			data-i18n="spotify.reset"
			>Reset</button
		>
	</div>

	<p class="mt-3 text-xs leading-relaxed text-mute" data-i18n="spotify.signIn">
		Full songs need a free Spotify sign-in — otherwise Spotify streams short previews. Or keep the built-in lo-fi tracks in the dock: always full-length and ad-free.
	</p>
</div>